{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "eebox module library",
  "description": "A library of DIN-rail modules and enclosures for eebox. See docs/library-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 300
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/definitions/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "url": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https?://\\S+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/module"
      }
    },
    "enclosures": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/enclosure"
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Starts with a letter or digit; letters, digits, '.', '_' and '-' only."
    },
    "conductor": {
      "enum": [
        "L",
        "L1",
        "L2",
        "L3",
        "N",
        "PE",
        "C",
        "DCP",
        "DCN"
      ],
      "description": "L is a phase decided by what feeds it; L1 to L3 are fixed phases."
    },
    "side": {
      "enum": [
        "top",
        "bottom"
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "widthUnits",
        "poles"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "kind": {
          "enum": [
            "breaker",
            "rcd",
            "rcbo",
            "contactor",
            "spd",
            "meter",
            "psu",
            "terminal",
            "busbar",
            "comb",
            "switch",
            "relay",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "widthUnits": {
          "type": "number",
          "minimum": 0.1,
          "description": "Width in 17.5 mm units; a fraction is fine, as a relay of 22.5 mm is 1.2857 units wide.",
          "maximum": 144
        },
        "poles": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "ratedCurrentA": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "curve": {
          "enum": [
            "B",
            "C",
            "D",
            "K",
            "Z"
          ]
        },
        "breakingCapacityKA": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "residualCurrentMa": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "terminals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/terminal"
          },
          "description": "Replaces the terminals derived from the pole count."
        },
        "comb": {
          "$ref": "#/definitions/comb"
        },
        "resizable": {
          "$ref": "#/definitions/resizable"
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000,
          "description": "What one costs, in `currency`; for pricing a bill of materials."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,8}$",
          "description": "Short code of the currency of `price`, for example EUR."
        },
        "logic": {
          "$ref": "#/definitions/logic"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "comb"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "comb"
            ],
            "not": {
              "required": [
                "terminals"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "comb"
              ]
            }
          }
        }
      ]
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "conductor",
        "side"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/identifier"
        },
        "conductor": {
          "$ref": "#/definitions/conductor"
        },
        "side": {
          "$ref": "#/definitions/side"
        },
        "net": {
          "$ref": "#/definitions/identifier",
          "description": "Terminals sharing a net are joined inside the module."
        },
        "unit": {
          "type": "number",
          "description": "Position of the terminal's centre in module units from the left edge, decimals allowed: 0 is the centre of the first unit, 0.5 the border between the first and the second. Spread evenly when omitted. Not allowed with count. It has to lie inside the module, 0.15 of a unit from either edge. On a resizable module a negative value counts from the right edge (-1 is the centre of the last unit), and either kind must exist at the narrowest width."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48,
          "description": "Repeats the terminal, numbering the names."
        }
      }
    },
    "comb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "side"
      ],
      "properties": {
        "pattern": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/conductor"
          }
        },
        "side": {
          "$ref": "#/definitions/side"
        }
      }
    },
    "logic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "contacts"
      ],
      "description": "What a relay or contactor does with the voltages it senses. Needs explicit terminals, which it refers to by id such as top:A1.",
      "properties": {
        "inputs": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/logicInput"
          }
        },
        "contacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/logicContact"
          }
        }
      }
    },
    "logicInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminals",
        "when"
      ],
      "properties": {
        "terminals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "when": {
          "enum": [
            "all",
            "any"
          ],
          "description": "all: every terminal carries voltage, on separate nets, as a coil's two terminals do. any: at least one does."
        }
      }
    },
    "logicContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "between",
        "closedWhen"
      ],
      "properties": {
        "between": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "closedWhen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "An expression over the input names with ! (not), & (and), | (or) and parentheses."
        }
      }
    },
    "resizable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minUnits",
        "maxUnits"
      ],
      "properties": {
        "minUnits": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 144
        },
        "maxUnits": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 144
        }
      }
    },
    "enclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "railLengthsUnits"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "railLengthsUnits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 144
          },
          "description": "Usable length of each DIN rail, top to bottom, in 17.5 mm units; a fraction is fine, as a rail cut to a measure is."
        }
      }
    }
  }
}
