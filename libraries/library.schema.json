{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "eebox module library",
  "description": "A library of DIN-rail modules and enclosures for eebox. See docs/library-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 300
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/definitions/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "url": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https?://\\S+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/module"
      }
    },
    "enclosures": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/enclosure"
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Starts with a letter or digit; letters, digits, '.', '_' and '-' only."
    },
    "conductor": {
      "enum": [
        "L",
        "L1",
        "L2",
        "L3",
        "N",
        "PE",
        "PEN",
        "C",
        "DCP",
        "DCN"
      ],
      "description": "L is a phase decided by what feeds it; L1 to L3 are fixed phases."
    },
    "side": {
      "enum": [
        "top",
        "bottom"
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "widthUnits",
        "poles"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "kind": {
          "enum": [
            "breaker",
            "rcd",
            "rcbo",
            "contactor",
            "spd",
            "meter",
            "psu",
            "terminal",
            "busbar",
            "comb",
            "switch",
            "relay",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^\\S(.*\\S)?$",
          "description": "What the face shows in place of the name, which is too long there. The palette and the parts list keep the name."
        },
        "widthUnits": {
          "type": "number",
          "minimum": 0.1,
          "description": "Width in 17.5 mm units; a fraction is fine, as a relay of 22.5 mm is 1.2857 units wide.",
          "maximum": 144
        },
        "poles": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "ratedCurrentA": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "curve": {
          "enum": [
            "B",
            "C",
            "D",
            "K",
            "Z"
          ]
        },
        "breakingCapacityKA": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "residualCurrentMa": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "terminals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/terminal"
          },
          "description": "Replaces the terminals derived from the pole count."
        },
        "comb": {
          "$ref": "#/definitions/comb"
        },
        "resizable": {
          "$ref": "#/definitions/resizable"
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000,
          "description": "What one costs, in `currency`; for pricing a bill of materials."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,8}$",
          "description": "Short code of the currency of `price`, for example EUR."
        },
        "logic": {
          "$ref": "#/definitions/logic"
        },
        "art": {
          "$ref": "#/definitions/art"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "comb"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "comb"
            ],
            "not": {
              "required": [
                "terminals"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "comb"
              ]
            }
          }
        }
      ]
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "conductor",
        "side"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/identifier"
        },
        "conductor": {
          "$ref": "#/definitions/conductor"
        },
        "side": {
          "$ref": "#/definitions/side"
        },
        "net": {
          "$ref": "#/definitions/identifier",
          "description": "Terminals sharing a net are joined inside the module."
        },
        "unit": {
          "type": "number",
          "description": "Position of the terminal's centre in module units from the left edge, decimals allowed: 0 is the centre of the first unit, 0.5 the border between the first and the second. Spread evenly when omitted. Not allowed with count. It has to lie inside the module, 0.15 of a unit from either edge (a quarter of the width on a module narrower than 0.6 units). On a resizable module a negative value counts from the right edge (-1 is the centre of the last unit), and either kind must exist at the narrowest width."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48,
          "description": "Repeats the terminal, numbering the names."
        }
      }
    },
    "comb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "side"
      ],
      "properties": {
        "pattern": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/conductor"
          }
        },
        "side": {
          "$ref": "#/definitions/side"
        }
      }
    },
    "logic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "contacts"
      ],
      "description": "What a relay or contactor does with the voltages it senses. Needs explicit terminals, which it refers to by id such as top:A1.",
      "properties": {
        "inputs": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/logicInput"
          }
        },
        "flags": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/logicFlag"
          },
          "description": "Facts a person sets on a placed copy, such as a latched impulse relay or an elapsed timer; contact expressions may use them like inputs."
        },
        "contacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/logicContact"
          }
        }
      }
    },
    "logicInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminals",
        "when"
      ],
      "properties": {
        "terminals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "when": {
          "enum": [
            "all",
            "any"
          ],
          "description": "all: every terminal carries voltage, on separate nets, as a coil's two terminals do. any: at least one does."
        }
      }
    },
    "logicFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "default"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "default": {
          "type": "boolean"
        }
      }
    },
    "logicContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "between",
        "closedWhen"
      ],
      "properties": {
        "between": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "closedWhen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "An expression over the input names with ! (not), & (and), | (or) and parentheses."
        }
      }
    },
    "resizable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minUnits",
        "maxUnits"
      ],
      "properties": {
        "minUnits": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 144
        },
        "maxUnits": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 144
        }
      }
    },
    "enclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "railLengthsUnits"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "railLengthsUnits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 144
          },
          "description": "Usable length of each DIN rail, top to bottom, in 17.5 mm units; a fraction is fine, as a rail cut to a measure is."
        }
      }
    },
    "artShape": {
      "description": "A shape on the face of a module, which is 90 mm tall and as wide as the module; coordinates are in mm from its top left corner, for the width the module is made for.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "x1",
            "y1",
            "x2",
            "y2",
            "stroke"
          ],
          "properties": {
            "kind": {
              "const": "line"
            },
            "x1": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000,
              "description": "Millimetres from the top left corner of the face."
            },
            "y1": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000,
              "description": "Millimetres from the top left corner of the face."
            },
            "x2": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000,
              "description": "Millimetres from the top left corner of the face."
            },
            "y2": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000,
              "description": "Millimetres from the top left corner of the face."
            },
            "anchor": {
              "enum": [
                "left",
                "right",
                "centre",
                "stretch",
                "tile"
              ],
              "description": "What a placed copy of another width does with the shape: stay at the left edge (default), follow the right edge, stay in the middle, stretch across the width, or repeat every `period` units."
            },
            "period": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 1000,
              "description": "Units between the repeats of a `tile` shape; only for the anchor tile."
            },
            "stroke": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "strokeWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20,
              "description": "Line width in mm; 0.5 when absent."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "kind": {
              "const": "rect"
            },
            "x": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000,
              "description": "Millimetres from the top left corner of the face."
            },
            "y": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000,
              "description": "Millimetres from the top left corner of the face."
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "description": "mm"
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "description": "mm"
            },
            "anchor": {
              "enum": [
                "left",
                "right",
                "centre",
                "stretch",
                "tile"
              ],
              "description": "What a placed copy of another width does with the shape: stay at the left edge (default), follow the right edge, stay in the middle, stretch across the width, or repeat every `period` units."
            },
            "period": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 1000,
              "description": "Units between the repeats of a `tile` shape; only for the anchor tile."
            },
            "stroke": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "strokeWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20,
              "description": "Line width in mm; 0.5 when absent."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cx",
            "cy",
            "rx",
            "ry"
          ],
          "properties": {
            "kind": {
              "const": "ellipse"
            },
            "cx": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000,
              "description": "Millimetres from the top left corner of the face."
            },
            "cy": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000,
              "description": "Millimetres from the top left corner of the face."
            },
            "rx": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "description": "mm"
            },
            "ry": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "description": "mm"
            },
            "anchor": {
              "enum": [
                "left",
                "right",
                "centre",
                "stretch",
                "tile"
              ],
              "description": "What a placed copy of another width does with the shape: stay at the left edge (default), follow the right edge, stay in the middle, stretch across the width, or repeat every `period` units."
            },
            "period": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 1000,
              "description": "Units between the repeats of a `tile` shape; only for the anchor tile."
            },
            "stroke": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "strokeWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20,
              "description": "Line width in mm; 0.5 when absent."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "points"
          ],
          "properties": {
            "kind": {
              "const": "polyline"
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                }
              },
              "description": "[x, y] pairs in mm."
            },
            "closed": {
              "type": "boolean",
              "description": "Joins the last point to the first; needed for a fill."
            },
            "anchor": {
              "enum": [
                "left",
                "right",
                "centre",
                "stretch",
                "tile"
              ],
              "description": "What a placed copy of another width does with the shape: stay at the left edge (default), follow the right edge, stay in the middle, stretch across the width, or repeat every `period` units."
            },
            "period": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 1000,
              "description": "Units between the repeats of a `tile` shape; only for the anchor tile."
            },
            "stroke": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "strokeWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20,
              "description": "Line width in mm; 0.5 when absent."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "x",
            "y",
            "text",
            "size",
            "fill"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "x": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000,
              "description": "Millimetres from the top left corner of the face."
            },
            "y": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000,
              "description": "Millimetres from the top left corner of the face."
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
              "description": "One line."
            },
            "size": {
              "type": "number",
              "minimum": 1,
              "maximum": 60,
              "description": "Height of the letters in mm."
            },
            "align": {
              "enum": [
                "left",
                "centre",
                "right"
              ]
            },
            "bold": {
              "type": "boolean"
            },
            "anchor": {
              "enum": [
                "left",
                "right",
                "centre",
                "stretch",
                "tile"
              ],
              "description": "What a placed copy of another width does with the shape: stay at the left edge (default), follow the right edge, stay in the middle, stretch across the width, or repeat every `period` units."
            },
            "period": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 1000,
              "description": "Units between the repeats of a `tile` shape; only for the anchor tile."
            },
            "stroke": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "strokeWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20,
              "description": "Line width in mm; 0.5 when absent."
            },
            "rotation": {
              "type": "number",
              "minimum": -360,
              "maximum": 360,
              "description": "Degrees clockwise about the point of the text; 90 is a quarter turn. The text is level when absent."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "d"
          ],
          "properties": {
            "kind": {
              "const": "path"
            },
            "d": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000,
              "pattern": "^M( -?\\d+(\\.\\d+)?){2}( (M|L)( -?\\d+(\\.\\d+)?){2}| C( -?\\d+(\\.\\d+)?){6}| Z)*$",
              "description": "Absolute path data in mm from the top left corner of the face: M x y, L x y, C x1 y1 x2 y2 x y and Z, separated by single spaces, at most 400 commands."
            },
            "anchor": {
              "enum": [
                "left",
                "right",
                "centre",
                "stretch",
                "tile"
              ],
              "description": "What a placed copy of another width does with the shape: stay at the left edge (default), follow the right edge, stay in the middle, stretch across the width, or repeat every `period` units."
            },
            "period": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 1000,
              "description": "Units between the repeats of a `tile` shape; only for the anchor tile."
            },
            "stroke": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "A colour like #1f2937."
            },
            "strokeWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20,
              "description": "Line width in mm; 0.5 when absent."
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "anchor": {
                "const": "tile"
              }
            },
            "required": [
              "anchor"
            ]
          },
          "then": {
            "required": [
              "period"
            ]
          },
          "else": {
            "not": {
              "required": [
                "period"
              ]
            }
          }
        }
      ]
    },
    "art": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/definitions/artShape"
      },
      "description": "What is drawn on the face of the module, under its name and terminals, first shape at the bottom."
    }
  }
}
