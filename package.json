{
  "name": "eebox",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based modular electrical panel designer with user-supplied module libraries.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:dist-file": "tsc --noEmit && vite build --config vite.config.file.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
